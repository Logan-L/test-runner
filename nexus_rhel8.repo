[ubi-8-baseos-rpms]
name = Red Hat Universal Base Image 8 (RPMs) - BaseOS
baseurl = https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi98/8/$basearch/baseos/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1
priority = 1

[ubi-8-appstream-rpms]
name = Red Hat Universal Base Image 8 (RPMs) - AppStream
baseurl = https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi8/8/$basearch/appstream/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1
priority = 1

[ubi-8-codeready-builder-rpms]
name = Red Hat Universal Base Image 8 (RPMs) - CodeReady Builder
baseurl = https://cdn-ubi.redhat.com/content/public/ubi/dist/ubi8/8/$basearch/codeready-builder/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
gpgcheck = 1
priority = 1

[epel]
name = Extra Packages for Enterprise Linux 8
baseurl = https://dl.fedoraproject.org/pub/epel/8/Everything/$basearch
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-8
gpgcheck = 1
priority = 2

[centos-stream-8-baseos]
name = CentOS Stream 8 (RPMs) - BaseOS
baseurl = https://mirror.stream.centos.org/8-stream/BaseOS/$basearch/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
gpgcheck = 1
priority = 3

[centos-stream-8-appstream]
name = CentOS Stream 8 (RPMs) - AppStream
baseurl = https://mirror.stream.centos.org/8-stream/AppStream/$basearch/os
enabled = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-Official
gpgcheck = 1
priority = 3
